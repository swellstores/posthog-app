{
  "$schema": "https://json.swell.store/setting.json",
  "label": "PostHog connection",
  "description": "Where your store events are sent.",
  "fields": [
    {
      "id": "api_key",
      "type": "short_text",
      "label": "Project API key",
      "placeholder": "phc_...",
      "required": true,
      "description": "PostHog → Project settings → Project API key. This key can only send events; it cannot read your PostHog data."
    },
    {
      "id": "host",
      "type": "select",
      "label": "PostHog region",
      "default": "us",
      "options": [
        { "value": "us", "label": "US Cloud" },
        { "value": "eu", "label": "EU Cloud" },
        { "value": "custom", "label": "Self-hosted or proxy" }
      ]
    },
    {
      "id": "custom_host",
      "type": "short_text",
      "label": "PostHog URL",
      "placeholder": "https://posthog.example.com",
      "conditions": { "connection.host": "custom" }
    },
    {
      "id": "send_test_event",
      "type": "action",
      "label": "Send test event",
      "function": "posthog-test",
      "loading_label": "Sending test event…",
      "description": "Save the settings first: actions are disabled while there are unsaved changes."
    }
  ]
}
